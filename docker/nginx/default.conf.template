# Rendered by the nginx image's envsubst step. Vars: API_UPSTREAM (e.g. http://api:8081).
# NOTE: nginx drops server-level add_header in any location that defines its own add_header.
# Claude Code: move the security headers into /etc/nginx/snippets/security-headers.conf and
# `include` it in every location that adds headers (/api/, /assets/, /index.html).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # ── security headers ──────────────────────────────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Replace THEME_SCRIPT_HASH at build time (vite plugin computes sha256 of the inline theme script)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-THEME_SCRIPT_HASH'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.ipify.org https://api6.ipify.org https://cloudflare-dns.com https://dns.google; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # ── API (JSON + SSE) ─────────────────────────────────────────────
    location /api/ {
        proxy_pass ${API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;            # SSE
        proxy_cache off;
        proxy_read_timeout 180s;
        add_header X-Accel-Buffering no;
    }

    # ── static assets ────────────────────────────────────────────────
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
