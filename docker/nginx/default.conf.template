# Rendered by the nginx image's envsubst step. Vars: API_UPSTREAM (e.g. http://api:8081), ENABLE_HSTS.
# Security headers live in /etc/nginx/snippets/security-headers.conf and are included in every
# location, because nginx drops server-level add_header in locations that define their own.

map "${ENABLE_HSTS}" $nettools_hsts {
    true    "max-age=31536000; includeSubDomains";
    default "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_static on;               # precompressed *.gz from the image build
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # ── API (JSON + SSE) ─────────────────────────────────────────────
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;            # SSE
        proxy_cache off;
        proxy_read_timeout 180s;
    }

    # Speed-test uploads are up to 32 MiB (the api caps them); every other API body keeps nginx's
    # 1 MiB default. Stream the body to the api instead of spooling it to disk first.
    location = /api/v1/speedtest/upload {
        include /etc/nginx/snippets/security-headers.conf;
        client_max_body_size 33m;
        proxy_request_buffering off;
        proxy_pass ${API_UPSTREAM}/api/v1/speedtest/upload;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    # ── static assets ────────────────────────────────────────────────
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    # Service worker and manifest must be revalidated so updates roll out.
    location ~ ^/(sw\.js|registerSW\.js|manifest\.webmanifest)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
