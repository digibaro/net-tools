# ── General ───────────────────────────────────────────────
NETTOOLS_PORT=8080
NETTOOLS_VERSION=latest           # image tag to pull
# NETTOOLS_BUILD_VERSION=dev      # baked into locally built images (shown at /api/v1/version)
# NETTOOLS_BUILD_COMMIT=unknown
# NETTOOLS_BUILD_DATE=unknown
NETTOOLS_PROFILE=public          # public | internal | homelab  (see docs/SECURITY.md)
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info                   # debug | info | warn | error
LOG_HASH_IPS=false
METRICS_ENABLED=false

# ── Target policy ─────────────────────────────────────────
ALLOW_PRIVATE_TARGETS=false      # profile default; true for internal/homelab
DENY_CIDRS=                      # extra comma-separated CIDRs to block
ALLOW_CIDRS=                     # if set, ONLY these targets are allowed
TRUSTED_PROXIES=172.16.0.0/12    # whose X-Forwarded-For is trusted

# ── Feature flags ─────────────────────────────────────────
PORTSCAN_ENABLED=false
IPERF_ENABLED=true
SNMP_ENABLED=false
AXFR_ENABLED=true
OPEN_RELAY_TEST_ENABLED=false
SERVER_INFO_ENABLED=              # server interfaces/routes tool; default off in public, on otherwise
NETTOOLS_LAN=false               # set by docker-compose.lan.yml
INSTALL_NMAP=false               # build arg for api image

# ── Limits ────────────────────────────────────────────────
RATE_LIMIT_RPM=60
RATE_LIMIT_HEAVY_RPM=10
CONCURRENCY_GLOBAL=32
CONCURRENCY_PER_IP=3
PING_MAX_COUNT=20
PING_MIN_INTERVAL_MS=200
TRACEROUTE_MAX_HOPS=30
MTR_MAX_CYCLES=20
PORTSCAN_MAX_PORTS=1024
PORTSCAN_RATE_PPS=200
IPERF_MAX_SECONDS=15
HTTP_MAX_BODY_BYTES=1048576
TOOL_TIMEOUT_DEFAULT=15s
STREAM_TIMEOUT_MAX=120s
BULK_MAX_TARGETS=50

# ── Data files (mounted read-only at /data) ───────────────
GEOIP_CITY_DB=/data/GeoLite2-City.mmdb
GEOIP_ASN_DB=/data/GeoLite2-ASN.mmdb

# ── Public API providers (leave empty to disable keyed ones) ─
GLOBALPING_TOKEN=                # optional, raises limits
IPINFO_TOKEN=
ABUSEIPDB_KEY=
PEERINGDB_KEY=
SSLLABS_EMAIL=
VIRUSTOTAL_KEY=
URLSCAN_KEY=
SAFEBROWSING_KEY=
RIPESTAT_SOURCEAPP=nettools      # identifies your app to RIPEstat
# Any *_KEY / *_TOKEN can also be given as *_FILE pointing at a Docker secret.

# ── Optional sidecars ─────────────────────────────────────
IPERF_PORT=5201
SPEEDTEST_PORT=8082
